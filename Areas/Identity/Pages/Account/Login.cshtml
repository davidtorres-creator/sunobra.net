@page
@model LoginModel
@{
    ViewData["Title"] = "Iniciar Sesión";
}

<div class="login-wrapper">
    <!-- Logo Superior Centrado -->
    <div class="logo-header">
        <img src="~/images/logo-sunobra.png" alt="Logo SunObra" class="logo-main">
        <h2 class="brand-name">SunObra</h2>
        <p class="brand-tagline">Soluciones en construcción y energía solar</p>
    </div>

    <!-- Contenedor del Formulario -->
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-5 col-md-7">
                <div class="login-card">
                    <div class="card-header-custom">
                        <h3 class="mb-1">Bienvenido</h3>
                        <p class="text-muted mb-0">Ingresa a tu cuenta</p>
                    </div>

                    <div class="card-body-custom">
                        <form id="account" method="post">
                            <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3" role="alert"></div>

                            <div class="input-group-custom mb-3">
                                <div class="input-icon">
                                    <i class="bi bi-envelope"></i>
                                </div>
                                <div class="form-floating flex-grow-1">
                                    <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="correo@ejemplo.com" />
                                    <label asp-for="Input.Email">Correo Electrónico</label>
                                </div>
                                <span asp-validation-for="Input.Email" class="text-danger small d-block mt-1"></span>
                            </div>

                            <div class="input-group-custom mb-3">
                                <div class="input-icon">
                                    <i class="bi bi-lock"></i>
                                </div>
                                <div class="form-floating flex-grow-1">
                                    <input asp-for="Input.Password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="contraseña" />
                                    <label asp-for="Input.Password">Contraseña</label>
                                </div>
                                <span asp-validation-for="Input.Password" class="text-danger small d-block mt-1"></span>
                            </div>

                            <div class="d-flex justify-content-between align-items-center mb-4">
                                <div class="form-check">
                                    <input class="form-check-input" asp-for="Input.RememberMe" />
                                    <label asp-for="Input.RememberMe" class="form-check-label small">
                                        Recordarme
                                    </label>
                                </div>
                                <a id="forgot-password" asp-page="./ForgotPassword" class="text-decoration-none small link-orange">
                                    ¿Olvidaste tu contraseña?
                                </a>
                            </div>

                            <div class="d-grid mb-3">
                                <button id="login-submit" type="submit" class="btn btn-orange btn-lg">
                                    <span>Iniciar Sesión</span>
                                    <i class="bi bi-arrow-right ms-2"></i>
                                </button>
                            </div>

                            @if ((Model.ExternalLogins?.Count ?? 0) > 0)
                            {
                                <div class="divider-custom">
                                    <span>O continúa con</span>
                                </div>

                                <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                                    <div class="d-grid gap-2">
                                        @foreach (var provider in Model.ExternalLogins!)
                                        {
                                            <button type="submit" class="btn btn-outline-dark" name="provider" value="@provider.Name">
                                                <i class="bi bi-@provider.Name.ToLower() me-2"></i>@provider.DisplayName
                                            </button>
                                        }
                                    </div>
                                </form>
                            }
                        </form>

                        <div class="text-center mt-4 pt-3 border-top">
                            <p class="text-muted small mb-2">¿No tienes una cuenta?</p>
                            <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl" class="btn btn-outline-orange">
                                Crear Cuenta
                            </a>
                        </div>

                        <div class="text-center mt-3">
                            <a id="resend-confirmation" asp-page="./ResendEmailConfirmation" class="text-muted text-decoration-none small">
                                Reenviar confirmación de email
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .login-wrapper {
        min-height: 100vh;
        background: linear-gradient(135deg, #1a1a1a 0%, #2d2d2d 100%);
        padding: 2rem 0;
        position: relative;
        overflow: hidden;
    }

        .login-wrapper::before {
            content: '';
            position: absolute;
            width: 500px;
            height: 500px;
            background: radial-gradient(circle, rgba(255, 140, 0, 0.2) 0%, transparent 70%);
            top: -200px;
            right: -200px;
            animation: float1 8s ease-in-out infinite;
        }

        .login-wrapper::after {
            content: '';
            position: absolute;
            width: 400px;
            height: 400px;
            background: radial-gradient(circle, rgba(255, 100, 0, 0.15) 0%, transparent 70%);
            bottom: -150px;
            left: -150px;
            animation: float2 10s ease-in-out infinite;
        }

    @@keyframes float1 {
        0%, 100% {
            transform: translate(0, 0) scale(1);
        }

        50% {
            transform: translate(-50px, 50px) scale(1.1);
        }
    }

    @@keyframes float2 {
        0%, 100% {
            transform: translate(0, 0) scale(1);
        }

        50% {
            transform: translate(50px, -30px) scale(1.15);
        }
    }

    /* Logo Header */
    .logo-header {
        text-align: center;
        margin-bottom: 3rem;
        position: relative;
        z-index: 1;
    }

    .logo-main {
        max-width: 150px;
        height: auto;
        margin-bottom: 1rem;
        animation: logoFloat 3s ease-in-out infinite;
        filter: drop-shadow(0 5px 15px rgba(255, 140, 0, 0.3));
    }

    @@keyframes logoFloat {
        0%, 100% {
            transform: translateY(0px);
        }

        50% {
            transform: translateY(-10px);
        }
    }

    .brand-name {
        color: #ff8c00;
        font-weight: 700;
        font-size: 2rem;
        margin-bottom: 0.5rem;
        text-shadow: 0 2px 10px rgba(255, 140, 0, 0.3);
    }

    .brand-tagline {
        color: #b0b0b0;
        font-size: 0.95rem;
    }

    /* Login Card */
    .login-card {
        background: #fff;
        border-radius: 1.5rem;
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
        overflow: hidden;
        position: relative;
        z-index: 1;
    }

    .card-header-custom {
        background: linear-gradient(135deg, #ff8c00 0%, #ff6b00 100%);
        padding: 2rem;
        text-align: center;
        color: white;
    }

        .card-header-custom h3 {
            font-weight: 700;
            color: white;
        }

        .card-header-custom .text-muted {
            color: rgba(255, 255, 255, 0.9) !important;
        }

    .card-body-custom {
        padding: 2rem;
    }

    /* Input Groups */
    .input-group-custom {
        position: relative;
    }

    .input-icon {
        position: absolute;
        left: 1rem;
        top: 1.3rem;
        z-index: 10;
        color: #ff8c00;
        font-size: 1.2rem;
    }

    .input-group-custom .form-floating {
        position: relative;
    }

    .input-group-custom .form-control {
        padding-left: 3rem;
        border: 2px solid #e0e0e0;
        border-radius: 0.75rem;
        transition: all 0.3s ease;
    }

        .input-group-custom .form-control:focus {
            border-color: #ff8c00;
            box-shadow: 0 0 0 0.2rem rgba(255, 140, 0, 0.15);
            transform: translateY(-2px);
        }

    .input-group-custom label {
        padding-left: 3rem;
        color: #6c757d;
    }

    /* Buttons */
    .btn-orange {
        background: linear-gradient(135deg, #ff8c00 0%, #ff6b00 100%);
        border: none;
        color: white;
        font-weight: 600;
        padding: 0.75rem 2rem;
        border-radius: 0.75rem;
        transition: all 0.3s ease;
        position: relative;
        overflow: hidden;
    }

        .btn-orange::before {
            content: '';
            position: absolute;
            top: 50%;
            left: 50%;
            width: 0;
            height: 0;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.2);
            transform: translate(-50%, -50%);
            transition: width 0.5s, height 0.5s;
        }

        .btn-orange:hover::before {
            width: 400px;
            height: 400px;
        }

        .btn-orange:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 25px rgba(255, 140, 0, 0.4);
        }

        .btn-orange span, .btn-orange i {
            position: relative;
            z-index: 1;
        }

    .btn-outline-orange {
        color: #ff8c00;
        border: 2px solid #ff8c00;
        font-weight: 600;
        padding: 0.5rem 2rem;
        border-radius: 0.75rem;
        transition: all 0.3s ease;
    }

        .btn-outline-orange:hover {
            background: #ff8c00;
            color: white;
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(255, 140, 0, 0.3);
        }

    .btn-outline-dark {
        border: 2px solid #2d2d2d;
        color: #2d2d2d;
        font-weight: 500;
        border-radius: 0.75rem;
        transition: all 0.3s ease;
    }

        .btn-outline-dark:hover {
            background: #2d2d2d;
            border-color: #2d2d2d;
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.2);
        }

    /* Links */
    .link-orange {
        color: #ff8c00;
        font-weight: 500;
        transition: color 0.3s ease;
    }

        .link-orange:hover {
            color: #ff6b00;
            text-decoration: underline !important;
        }

    /* Divider */
    .divider-custom {
        text-align: center;
        margin: 1.5rem 0;
        position: relative;
    }

        .divider-custom::before,
        .divider-custom::after {
            content: '';
            position: absolute;
            top: 50%;
            width: 40%;
            height: 1px;
            background: #e0e0e0;
        }

        .divider-custom::before {
            left: 0;
        }

        .divider-custom::after {
            right: 0;
        }

        .divider-custom span {
            background: white;
            padding: 0 1rem;
            color: #6c757d;
            font-size: 0.875rem;
        }

    /* Responsive */
    @@media (max-width: 767px) {
        .login-wrapper {
            padding: 1rem 0;
        }

        .logo-main {
            max-width: 100px;
        }

        .brand-name {
            font-size: 1.5rem;
        }

        .card-header-custom,
        .card-body-custom {
            padding: 1.5rem;
        }
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}